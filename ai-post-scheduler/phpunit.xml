<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
>
    <!-- Segregated Test Suites for faster TDD -->
    <testsuites>
        <testsuite name="All">
            <directory suffix=".php">./tests</directory>
            <exclude>./tests/bootstrap.php</exclude>
            <exclude>./tests/index.php</exclude>
            <exclude>./tests/test-batch-queue-service.php</exclude>
        </testsuite>
    </testsuites>

    <!--
        Coverage configuration is intentionally NOT declared here. When a
        <coverage> block is present, PHPUnit 9 boots its coverage driver on
        every run and warns unless Xdebug is in `coverage` mode (or PCOV is
        loaded). Since Xdebug defaults to off, we drive coverage via CLI
        flags from `composer test:coverage` instead — see composer.json.
    -->

    <php>
        <const name="WP_TESTS_PHPUNIT_POLYFILLS_PATH" value="vendor/yoast/phpunit-polyfills"/>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
