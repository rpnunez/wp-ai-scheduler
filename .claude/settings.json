{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test-session)",
      "Bash(make test-session *)",
      "Bash(make test ARGS=*)",
      "Bash(make test-stop)",
      "Bash(make stop)",
      "Bash(make start)",
      "Bash(make urls)",
      "Bash(make status)",
      "Bash(make info)",
      "Bash(make help)",
      "Bash(make composer-install)",
      "Bash(make sql-batch *)",
      "Bash(docker ps *)",
      "Bash(docker compose ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(php -l *)",
      "Bash(composer lint:repository-boundary)",
      "Bash(php tools/check-repository-boundary.php)"
    ],
    "deny": [
      "Bash(make down*)",
      "Bash(make clean*)",
      "Bash(make prune*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker compose down -v*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/aips-hooks.php\" guard-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/aips-hooks.php\" post-edit",
            "timeout": 30,
            "statusMessage": "AIPS lint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/aips-hooks.php\" session-start",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
